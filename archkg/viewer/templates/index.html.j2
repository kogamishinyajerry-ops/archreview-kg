<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<title>ArchReview-KG · Demo Viewer</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<style>
  :root {
    --bg: #0e1014;
    --panel: #161a22;
    --border: #2a3140;
    --text: #e6edf3;
    --muted: #7d8590;
    --blue: #2f81f7;
    --orange: #f59e0b;
    --red: #f85149;
    --green: #3fb950;
    --yellow: #eac54f;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 0; font: 14px/1.55 -apple-system, BlinkMacSystemFont,
      "Segoe UI", "PingFang SC", "Hiragino Sans GB", sans-serif;
    background: var(--bg); color: var(--text);
  }
  header {
    padding: 20px 28px; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 16px;
  }
  header h1 { font-size: 20px; margin: 0; font-weight: 600; }
  header .badge {
    background: var(--green); color: #00130a; padding: 2px 10px;
    border-radius: 999px; font-size: 12px; font-weight: 600;
  }
  header .meta { color: var(--muted); font-size: 13px; margin-left: auto; }
  main { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 16px; }
  .full { grid-column: 1 / -1; }
  .panel {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 10px; padding: 16px;
  }
  .panel h2 { margin: 0 0 10px; font-size: 14px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .panel img { max-width: 100%; border: 1px solid var(--border); border-radius: 6px; background: #fff; }
  .panel iframe { width: 100%; height: 520px; border: 1px solid var(--border); border-radius: 6px; background: #fff; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .stat {
    background: var(--bg); border: 1px solid var(--border);
    padding: 12px 14px; border-radius: 8px;
  }
  .stat .v { font-size: 28px; font-weight: 700; color: var(--blue); }
  .stat .v.warn { color: var(--orange); }
  .stat .v.bad { color: var(--red); }
  .stat .v.ok { color: var(--green); }
  .stat .k { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  table th { text-align: left; color: var(--muted); padding: 8px 10px; border-bottom: 1px solid var(--border); font-weight: 600; }
  table td { padding: 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
  table tr:hover { background: rgba(47, 129, 247, 0.06); }
  code { background: rgba(110,118,129,.18); padding: 1px 6px; border-radius: 4px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .severity-error { color: var(--red); font-weight: 600; }
  .pipeline { display: flex; gap: 0; margin: 8px 0 16px; }
  .step {
    flex: 1; background: var(--bg); border: 1px solid var(--border);
    padding: 10px 14px; position: relative;
  }
  .step:first-child { border-radius: 8px 0 0 8px; }
  .step:last-child { border-radius: 0 8px 8px 0; }
  .step + .step { border-left: none; }
  .step .num { color: var(--blue); font-weight: 700; font-size: 12px; }
  .step .name { font-weight: 600; }
  .step .out { color: var(--muted); font-size: 12px; font-family: ui-monospace, monospace; }
  details { margin-top: 8px; }
  summary { cursor: pointer; color: var(--muted); font-size: 12px; }
  pre {
    background: var(--bg); border: 1px solid var(--border); border-radius: 6px;
    padding: 12px; overflow: auto; font-size: 12px; max-height: 320px;
  }
  .links a { color: var(--blue); text-decoration: none; margin-right: 12px; font-size: 13px; }
  .links a:hover { text-decoration: underline; }
  .footer { padding: 14px 28px; color: var(--muted); font-size: 12px; border-top: 1px solid var(--border); }
</style>
</head>
<body>

<header>
  <h1>🏛️ ArchReview-KG · Demo Viewer</h1>
  <span class="badge">{{ issues|length }} issues flagged</span>
  <span class="meta">{{ source_pdf }} · {{ created_at }}</span>
</header>

<main>

<section class="panel full">
  <h2>① 流水线</h2>
  <div class="pipeline">
    <div class="step"><div class="num">1</div><div class="name">PDF Ingest</div><div class="out">primitives.json · {{ stats.lines }} lines · {{ stats.texts }} texts</div></div>
    <div class="step"><div class="num">2</div><div class="name">Entity Graph</div><div class="out">{{ stats.rooms }} rooms · {{ stats.doors }} doors · {{ stats.corridors }} corridor</div></div>
    <div class="step"><div class="num">3</div><div class="name">Rule Engine</div><div class="out">3 rule cards × {{ stats.applicable_entities }} entities</div></div>
    <div class="step"><div class="num">4</div><div class="name">Annotate + Report</div><div class="out">annotated.pdf · report.md</div></div>
    <div class="step"><div class="num">5</div><div class="name">Feedback</div><div class="out">report.md → feedback.yaml</div></div>
  </div>
  <div class="stats">
    <div class="stat"><div class="v ok">{{ stats.rooms }}</div><div class="k">Rooms</div></div>
    <div class="stat"><div class="v">{{ stats.doors }}</div><div class="k">Doors</div></div>
    <div class="stat"><div class="v">{{ stats.corridors }}</div><div class="k">Corridors</div></div>
    <div class="stat"><div class="v {% if issues %}bad{% else %}ok{% endif %}">{{ issues|length }}</div><div class="k">Issues</div></div>
  </div>
  <div class="links" style="margin-top: 12px;">
    <a href="entity_graph.json" target="_blank">📦 entity_graph.json</a>
    <a href="issues.json" target="_blank">📋 issues.json</a>
    <a href="primitives.json" target="_blank">🧱 primitives.json</a>
    <a href="report.md" target="_blank">📝 report.md</a>
    <a href="feedback.yaml" target="_blank">✉️ feedback.yaml</a>
  </div>
</section>

<section class="panel">
  <h2>② 源图纸</h2>
  <img src="source_preview.png" alt="source plan" />
  <details><summary>下载源 PDF</summary><a href="source.pdf" target="_blank">source.pdf</a></details>
</section>

<section class="panel">
  <h2>③ 实体识别（彩色 overlay）</h2>
  <img src="entity_overlay.png" alt="entity overlay" />
</section>

<section class="panel full">
  <h2>④ 问题清单（{{ issues|length }} 条）</h2>
  {% if issues %}
  <table>
    <thead>
      <tr>
        <th>#</th><th>issue_id</th><th>rule</th><th>条文</th>
        <th>实体</th><th>测量</th><th>阈值</th><th>说明</th>
      </tr>
    </thead>
    <tbody>
      {% for i in issues %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><code>{{ i.issue_id }}</code></td>
        <td><code>{{ i.rule_card_id }}</code></td>
        <td><code>{{ i.standard_clause_id }}</code></td>
        <td><code>{{ i.entity_ids|join(', ') }}</code></td>
        <td><span class="severity-error">{{ "%.2f"|format(i.evidence.measured_value) if i.evidence.measured_value is not none else '—' }}</span></td>
        <td>{{ "%.2f"|format(i.evidence.threshold_value) if i.evidence.threshold_value is not none else '—' }} {{ i.evidence.unit or '' }}</td>
        <td>{{ i.message }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="color: var(--green);">✓ 未发现违反规则的实体</p>
  {% endif %}
</section>

<section class="panel full">
  <h2>⑤ 标注 PDF</h2>
  <img src="annotated_preview.png" alt="annotated pdf" />
  <details><summary>下载 annotated.pdf</summary><a href="annotated.pdf" target="_blank">annotated.pdf</a></details>
</section>

<section class="panel full">
  <h2>⑥ Markdown 报告</h2>
  <pre>{{ report_md }}</pre>
</section>

</main>

<div class="footer">
  ArchReview-KG demo viewer · 静态、只读、零状态。规则与图谱由 CLI 命令 <code>archkg review</code> 产生。
</div>
</body>
</html>
