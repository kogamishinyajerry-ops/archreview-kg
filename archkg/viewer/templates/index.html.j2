<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<title>ArchReview-KG · 工作台结果</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<style>
  :root {
    --bg: #0b0f16;
    --panel: rgba(22, 30, 42, 0.9);
    --panel-soft: rgba(255, 255, 255, 0.04);
    --panel-line: rgba(76, 104, 150, 0.35);
    --text: #eaf0f8;
    --muted: #93a0b4;
    --blue: #3a83ff;
    --green: #4bd37b;
    --orange: #ffb84b;
    --red: #ff5c55;
    --tier-autodetect: #4bd37b;
    --tier-partial: #5cc8ff;
    --tier-project: #35d0d0;
    --tier-reminder: #ffdf76;
    --tier-stair: #ff8f4a;
    --tier-unknown: #9aa8bc;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    color: var(--text);
    font: 14px/1.6 "Noto Sans SC", "PingFang SC", "Microsoft YaHei", "Source Han Sans CN", "WenQuanYi Micro Hei", sans-serif;
    background: radial-gradient(1300px 700px at 12% -8%, #1a2740 0%, transparent 46%),
      radial-gradient(800px 600px at 100% 0%, #132235 0%, transparent 40%),
      var(--bg);
  }
  a { color: inherit; }
  img { display: block; width: 100%; border-radius: 10px; }

  .page {
    max-width: 1320px;
    margin: 0 auto;
    padding: 18px;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    padding: 12px 0 18px;
    border-bottom: 1px solid var(--panel-line);
  }
  .eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: .08em;
  }
  .title {
    margin: 2px 0 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: .01em;
  }
  .meta {
    color: var(--muted);
    font-size: 12px;
    margin-top: 2px;
  }
  .badge {
    border: 1px solid var(--panel-line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    padding: 8px 12px;
    font-weight: 700;
    font-size: 12px;
    white-space: nowrap;
  }
  .badge.ok {
    color: #7fffc1;
    border-color: rgba(75, 211, 123, 0.5);
    background: rgba(75, 211, 123, 0.13);
  }
  .badge.warn {
    color: #ffcd75;
    border-color: rgba(255, 184, 75, 0.55);
    background: rgba(255, 184, 75, 0.14);
  }
  .badge.bad {
    color: #ff7d8a;
    border-color: rgba(255, 92, 85, 0.45);
    background: rgba(255, 92, 85, 0.14);
  }

  .panel {
    margin-top: 14px;
    background: linear-gradient(180deg, rgba(17, 23, 33, 0.86), rgba(17, 23, 33, 0.72));
    border: 1px solid var(--panel-line);
    border-radius: 14px;
    padding: 16px;
  }
  .full { grid-column: 1 / -1; }
  .panel h2 {
    margin: 0 0 12px;
    color: #c4d2ea;
    font-size: 14px;
    letter-spacing: .02em;
  }
  .alert {
    border-radius: 12px;
    border: 1px solid transparent;
    padding: 11px 14px;
    line-height: 1.8;
    margin-top: 10px;
  }
  .alert.warn {
    border-color: rgba(255, 184, 75, 0.45);
    background: rgba(255, 184, 75, 0.1);
    color: #ffebb3;
  }
  .alert.fail {
    border-color: rgba(255, 92, 85, 0.4);
    background: rgba(255, 92, 85, 0.09);
    color: #ffd0ce;
  }
  .alert.soft {
    border-color: rgba(75, 211, 123, 0.33);
    background: rgba(75, 211, 123, 0.12);
    color: #c9ffd8;
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .kpi {
    border: 1px solid var(--panel-line);
    border-radius: 10px;
    padding: 12px;
    background: var(--panel-soft);
  }
  .kpi .k { color: var(--muted); font-size: 12px; }
  .kpi .v {
    margin-top: 4px;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: .01em;
    color: var(--blue);
  }
  .kpi.bad .v { color: var(--red); }
  .kpi.warn .v { color: var(--orange); }
  .kpi.ok .v { color: var(--green); }

  .flow {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--panel-line);
    border-radius: 10px;
    overflow: hidden;
  }
  .flow .f {
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.03);
    border-right: 1px solid var(--panel-line);
  }
  .flow .f:last-child { border-right: 0; }
  .flow .idx {
    color: var(--blue);
    font-weight: 800;
    margin-bottom: 2px;
  }
  .flow .name { font-weight: 600; }
  .flow .out { font-size: 12px; color: var(--muted); }

  .risk {
    margin-top: 14px;
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr 1fr 1fr;
  }
  .risk-item {
    border-radius: 10px;
    border: 1px solid var(--panel-line);
    background: rgba(255, 255, 255, 0.03);
    padding: 10px;
  }
  .risk-item b { font-size: 22px; display: block; }
  .risk-item .t { color: var(--muted); font-size: 12px; margin-top: 4px; }
  .evidence-list {
    display: grid;
    gap: 8px;
  }
  .evidence-row {
    display: grid;
    grid-template-columns: minmax(120px, 0.9fr) minmax(90px, 0.5fr) minmax(130px, 0.8fr) minmax(130px, 1fr);
    gap: 10px;
    align-items: center;
    border: 1px solid rgba(76, 104, 150, 0.32);
    border-radius: 8px;
    padding: 8px 10px;
    background: rgba(255, 255, 255, 0.025);
  }
  .evidence-row .text {
    font-weight: 700;
    color: #eaf0f8;
    word-break: break-word;
  }
  .evidence-row .sub {
    color: var(--muted);
    font-size: 12px;
  }
  .evidence-row.low {
    border-color: rgba(255, 184, 75, 0.45);
    background: rgba(255, 184, 75, 0.08);
  }

  .metric-grid {
    margin-top: 12px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 12px;
  }
  .metric-card {
    border: 1px solid var(--panel-line);
    border-radius: 10px;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.03);
  }
  .metric-card h3 {
    margin: 0 0 10px;
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .knowledge-grid {
    margin-top: 12px;
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr 1fr;
  }
  .knowledge-card {
    border: 1px solid var(--panel-line);
    border-radius: 10px;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.03);
  }
  .knowledge-kpi {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .knowledge-kpi .item {
    border: 1px dashed var(--panel-line);
    border-radius: 10px;
    padding: 8px 10px;
    background: rgba(255, 255, 255, 0.02);
  }
  .knowledge-kpi .n {
    font-size: 22px;
    margin-top: 2px;
    color: #d9e6ff;
  }
  .knowledge-kpi .l {
    color: var(--muted);
    font-size: 12px;
  }
  .knowledge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
  .knowledge-item {
    border: 1px dashed var(--panel-line);
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 12px;
    color: var(--muted);
  }
  .metric-card .bar {
    display: grid;
    gap: 4px;
  }
  .metric-note {
    color: var(--muted);
    font-size: 11px;
    margin-top: 8px;
  }
  .bar-row {
    display: grid;
    grid-template-columns: 72px 1fr 50px;
    gap: 8px;
    align-items: center;
    font-size: 12px;
    color: var(--muted);
  }
  .bar-label { color: #c7d6ee; }
  .bar-track {
    height: 9px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .bar-fill {
    height: 100%;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.6));
  }
  .bar-value {
    text-align: right;
    color: #d8e3ff;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .gallery {
    margin-top: 14px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .img-card {
    border: 1px solid var(--panel-line);
    border-radius: 10px;
    background: #111827;
    overflow: hidden;
  }
  .img-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    font-weight: 600;
    font-size: 13px;
    border-bottom: 1px solid var(--panel-line);
  }
  .img-head .muted { color: var(--muted); font-weight: 400; }
  .img-wrap { background: #0d1320; padding: 8px; }
  .img-wrap.layer-view {
    position: relative;
    min-height: 220px;
    display: grid;
    align-items: center;
    justify-items: center;
  }
  .img-wrap.layer-view img {
    width: 100%;
    border-radius: 8px;
  }
  .layer-switch {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 6px 0 10px;
  }
  .layer-switch .chip {
    border: 1px solid var(--panel-line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--muted);
    padding: 6px 10px;
    font-size: 12px;
    cursor: pointer;
    font-family: inherit;
  }
  .layer-switch .chip.active {
    color: #cbe1ff;
    border-color: rgba(87, 151, 255, 0.6);
    background: rgba(58, 131, 255, 0.22);
  }
  .layer-switch .chip:focus-visible {
    outline: 2px solid rgba(87, 151, 255, 0.6);
    outline-offset: 2px;
  }
  .layer-switch .chip.is-disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  .issue-list {
    margin-top: 14px;
    display: grid;
    gap: 10px;
    max-height: 520px;
    overflow: auto;
  }
  .issue-item {
    border: 1px solid var(--panel-line);
    border-radius: 12px;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.02);
  }
  .issue-item .line {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .issue-item.tier-autodetectable {
    border-left: 4px solid var(--tier-autodetect);
  }
  .issue-item.tier-partial-autodetect {
    border-left: 4px solid var(--tier-partial);
  }
  .issue-item.tier-project-meta-driven {
    border-left: 4px solid var(--tier-project);
  }
  .issue-item.tier-reminder-by-design {
    border-left: 4px solid var(--tier-reminder);
  }
  .issue-item.tier-stair-pending {
    border-left: 4px solid var(--tier-stair);
  }
  .issue-item.tier-unknown {
    border-left: 4px solid var(--tier-unknown);
  }
  .issue-item .level {
    font-size: 12px;
    border-radius: 999px;
    padding: 2px 8px;
    border: 1px solid rgba(255,255,255,0.2);
  }
  .issue-item .level.severity-error {
    color: var(--red);
    border-color: rgba(255,92,85,.45);
  }
  .issue-item .level.severity-warning {
    color: var(--orange);
    border-color: rgba(255,184,75,.45);
  }
  .issue-item .level.severity-info {
    color: var(--blue);
    border-color: rgba(58,131,255,.35);
  }

  .pill {
    color: var(--muted);
    font-size: 12px;
    border: 1px dashed var(--panel-line);
    border-radius: 999px;
    padding: 2px 7px;
    margin-left: 4px;
  }
  .tier-pill {
    color: #ecf2ff;
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.08);
  }
  .tier-pill.tier-autodetectable { color: #63e089; border-color: rgba(75, 211, 123, .6); background: rgba(75, 211, 123, .12); }
  .tier-pill.tier-partial-autodetect { color: #8acbff; border-color: rgba(92, 200, 255, .56); background: rgba(92, 200, 255, .12); }
  .tier-pill.tier-project-meta-driven { color: #6ff3f3; border-color: rgba(53, 208, 208, .5); background: rgba(53, 208, 208, .14); }
  .tier-pill.tier-reminder-by-design { color: #f6db80; border-color: rgba(255, 223, 118, .5); background: rgba(255, 223, 118, .12); }
  .tier-pill.tier-stair-pending { color: #ffac6a; border-color: rgba(255, 143, 74, .5); background: rgba(255, 143, 74, .12); }
  .tier-pill.tier-unknown { color: #b4bfd3; border-color: rgba(154, 168, 188, .56); background: rgba(154, 168, 188, .12); }
  .status-pill {
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    padding: 2px 8px;
    color: #eaf0f8;
    background: rgba(255, 255, 255, 0.08);
    font-size: 12px;
    white-space: nowrap;
  }
  .status-ready { color: #7fffc1; border-color: rgba(75, 211, 123, .55); background: rgba(75, 211, 123, .12); }
  .status-missing-input { color: #ffcd75; border-color: rgba(255, 184, 75, .55); background: rgba(255, 184, 75, .12); }
  .status-low-confidence { color: #ffdf76; border-color: rgba(255, 223, 118, .55); background: rgba(255, 223, 118, .12); }
  .status-manual-only { color: #9ec2ff; border-color: rgba(58, 131, 255, .45); background: rgba(58, 131, 255, .12); }
  .status-not-applicable { color: #b4bfd3; border-color: rgba(154, 168, 188, .55); background: rgba(154, 168, 188, .12); }
  .status-unsupported-entity { color: #ff9d99; border-color: rgba(255, 92, 85, .45); background: rgba(255, 92, 85, .12); }
  .issue-message {
    margin: 8px 0 0;
    color: #dbe7fc;
    font-size: 13px;
  }
  .links {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .links a {
    color: #9cc4ff;
    text-decoration: none;
    border-bottom: 1px dashed rgba(156, 196, 255, 0.6);
    font-size: 13px;
  }

  .side {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 14px;
  }
  .quick-rail {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    margin-top: 10px;
  }
  .quick-chip {
    border: 1px solid var(--panel-line);
    border-radius: 12px;
    padding: 10px;
    text-decoration: none;
    color: var(--text);
    background: linear-gradient(180deg, rgba(19, 27, 40, 0.96), rgba(13, 20, 32, 0.9));
  }
  .quick-chip:hover {
    border-color: rgba(120, 170, 255, 0.55);
  }
  .quick-chip .qk {
    color: var(--blue);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: .02em;
  }
  .quick-chip .qv {
    margin-top: 6px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }
  .ref-list {
    margin: 0;
    padding-left: 16px;
    color: var(--text);
    font-size: 13px;
  }
  .ref-item {
    margin: 0 0 8px;
  }
  .ref-id {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    background: rgba(58, 131, 255, 0.12);
    border-radius: 6px;
    padding: 1px 5px;
    color: #9ec2ff;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  th {
    text-align: left;
    color: var(--muted);
    border-bottom: 1px solid var(--panel-line);
    font-weight: 600;
    padding: 8px 10px;
    font-size: 12px;
  }
  td {
    border-bottom: 1px solid rgba(76,104,150,0.2);
    padding: 8px 10px;
    vertical-align: top;
    color: #dde8ff;
    line-height: 1.45;
  }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #9ec2ff;
  }

  .footer {
    margin: 12px 0 30px;
    color: var(--muted);
    font-size: 11px;
    text-align: center;
  }

  @media (max-width: 1100px) {
    .kpis,
    .flow,
    .risk,
    .metric-grid,
    .knowledge-grid,
    .knowledge-kpi,
    .gallery,
    .side {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 720px) {
    .page { padding: 12px; }
    header {
      display: block;
    }
    .badge { margin-top: 8px; display: inline-block; }
    .kpis,
    .flow,
    .risk,
    .knowledge-kpi,
    .gallery,
    .side,
    .metric-grid {
      grid-template-columns: 1fr;
    }
  }

  .table-wrap {
    max-height: 360px;
    overflow: auto;
    border: 1px solid var(--panel-line);
    border-radius: 12px;
    margin-top: 10px;
    background: rgba(255, 255, 255, 0.02);
  }
  .report {
    margin-top: 12px;
    background: #0f1722;
    border: 1px solid var(--panel-line);
    border-radius: 12px;
    padding: 12px;
    max-height: 340px;
    overflow: auto;
  }
  .report pre {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
    color: #dbe6ff;
    font-size: 12px;
    line-height: 1.5;
    max-height: 300px;
    overflow: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
</style>
</head>
<body>

<div class="page">
{% set issue_metrics = issue_metrics | default({'severity_chart': [], 'top_rules': [], 'top_clauses': [], 'rule_tier_bars': [], 'rule_tiers': {}}, true) %}
{% set knowledge_overview = knowledge_overview | default({}, true) %}
{% set layer_available = layer_available | default({'source': true, 'overlay': true, 'annotated': true}, true) %}
{% set issue_tiers = issue_tiers | default(issue_metrics.rule_tiers | default({}, true), true) %}
{% set rule_readiness = rule_readiness | default({'available': false, 'summary_rows': [], 'source_rows': [], 'non_ready_rules': [], 'warning_text': '规则输入就绪度暂无数据；缺失 readiness 不代表通过。', 'unavailable_reason': 'missing'}, true) %}
{% set sheet_region_candidates = sheet_region_candidates | default({'available': false, 'candidates': [], 'excluded_texts': [], 'warning_text': '候选区域暂无数据; 缺失 candidate artifact 不代表已裁剪或已确认.', 'unavailable_reason': 'missing'}, true) %}

<header>
  <div>
    <p class="eyebrow">ArchReview-KG · 民用建筑审图看板</p>
    <h1 class="title">设计图快速复核结果</h1>
    <p class="meta">{{ source_pdf }} · {{ created_at }}</p>
  </div>
  {% if mode is defined and mode == "inspect_only" %}
    <span class="badge warn">规则评估未执行 · 仅识图模式</span>
  {% else %}
    {% set issue_total = issue_summary.total if issue_summary is defined else issues|length %}
    {% if issue_total == 0 %}
      <span class="badge ok">当前暂无规则违背</span>
    {% else %}
      <span class="badge bad">发现 {{ issue_total }} 条复核项</span>
    {% endif %}
  {% endif %}
</header>

{% if mode is defined and mode == "inspect_only" %}
  <section class="panel">
    <div class="alert fail">
      <strong>规则评估未执行</strong>：仅做 PDF Ingest + Entity Graph，未运行规则引擎。
      下方“问题清单”为空不代表合规，先确认识图实体数量合理后再跑完整审图。
    </div>
  </section>
{% endif %}

{% if quality_flags is defined and quality_flags %}
  <section class="panel">
    <div class="alert warn">
      <strong>质量提示</strong>：识图噪声信号，建议先复核实体数量再读报告。
      <ul style="margin: 6px 0 0 18px; padding: 0;">
      {% for flag in quality_flags %}
        <li>{{ flag }}</li>
      {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}

<section class="panel">
  <h2>快速路径</h2>
  <div class="quick-rail">
    <a class="quick-chip" href="#panel-layer">
      <span class="qk">01 识图图层</span>
      <div class="qv">实体图层 / 标注图一键对照</div>
    </a>
    <a class="quick-chip" href="#panel-issues">
      <span class="qk">02 问题面板</span>
      <div class="qv">高风险与热点规则先看图</div>
    </a>
    <a class="quick-chip" href="#panel-readiness">
      <span class="qk">03 就绪度</span>
      <div class="qv">缺输入、不适用、人工核对分清楚</div>
    </a>
    <a class="quick-chip" href="#panel-sheet-regions">
      <span class="qk">04 候选区域</span>
      <div class="qv">设计区、标题栏、排表先确认</div>
    </a>
    <a class="quick-chip" href="#panel-report">
      <span class="qk">05 报告与条文</span>
      <div class="qv">快速打开报告与条文触达</div>
    </a>
  </div>
</section>

<section class="panel">
  <h2>① 快速健康度</h2>
  <div class="kpis">
    <div class="kpi">
      <div class="k">Rooms</div>
      <div class="v">{{ stats.rooms }}</div>
    </div>
    <div class="kpi warn">
      <div class="k">Doors</div>
      <div class="v">{{ stats.doors }}</div>
    </div>
    <div class="kpi">
      <div class="k">Corridors</div>
      <div class="v">{{ stats.corridors }}</div>
    </div>
    <div class="kpi {% if not (mode is defined and mode == 'inspect_only') and issues %}bad{% endif %}">
      <div class="k">问题</div>
      <div class="v">{{ issues|length }}</div>
    </div>
  </div>

  <div class="metric-grid">
    <div class="metric-card">
      <h3>风险占比</h3>
      <div class="bar">
        {% for row in issue_metrics.severity_chart %}
          <div class="bar-row">
            <div class="bar-label">{{ row.label }}</div>
            <div class="bar-track">
              <div class="bar-fill" style="width: {{ "%.1f"|format(row.pct) }}%; background: {{ row.color }};"></div>
            </div>
            <div class="bar-value">{{ row.count }}（{{ "%.1f"|format(row.pct) }}%）</div>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="metric-card">
      <h3>热点规则（Top {{ issue_metrics.top_rules | length }}）</h3>
      <div class="bar">
        {% if issue_metrics.top_rules %}
          {% for row in issue_metrics.top_rules %}
            {% set tier_key = row.tier | default('UNKNOWN') | lower | replace('_', '-') %}
            <div class="bar-row">
              <div class="bar-label">
                {{ row.rule_card_id }}
                <span class="pill tier-pill tier-{{ tier_key }}">{{ row.tier }}</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill" style="width: {{ "%.1f"|format(row.pct) }}%; background: {{ row.color }};"></div>
              </div>
              <div class="bar-value">{{ row.count }} / {{ issue_summary.total }}</div>
            </div>
          {% endfor %}
        {% else %}
          <div class="bar-row" style="grid-template-columns:1fr;">
            <div class="bar-label">当前无规则触发，可复核规则链路是否完整</div>
          </div>
        {% endif %}
      </div>

      <div class="metric-note">规则类型分层（Top 列表）</div>
      <div class="bar">
        {% if issue_metrics.rule_tier_bars %}
          {% for row in issue_metrics.rule_tier_bars %}
            <div class="bar-row">
              <div class="bar-label">{{ row.label }}</div>
              <div class="bar-track">
                <div class="bar-fill" style="width: {{ "%.1f"|format(row.pct) }}%; background: {{ row.color }};"></div>
              </div>
              <div class="bar-value">{{ row.count }}</div>
            </div>
          {% endfor %}
        {% else %}
          <div class="bar-row" style="grid-template-columns:1fr;">
            <div class="bar-label" style="color: var(--muted);">当前无可用分层数据</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="flow">
    <div class="f"><div class="idx">1</div><div class="name">PDF Ingest</div><div class="out">primitives.json · {{ stats.lines }} line · {{ stats.texts }} text</div></div>
    <div class="f"><div class="idx">2</div><div class="name">Entity Graph</div><div class="out">{{ stats.rooms }} rooms · {{ stats.doors }} doors · {{ stats.corridors }} corridors</div></div>
    {% if mode is defined and mode == "inspect_only" %}
      <div class="f" style="opacity:.45"><div class="idx">3</div><div class="name">Rule Engine</div><div class="out">skipped</div></div>
      <div class="f" style="opacity:.45"><div class="idx">4</div><div class="name">Annotate + Report</div><div class="out">skipped</div></div>
      <div class="f" style="opacity:.45"><div class="idx">5</div><div class="name">Feedback</div><div class="out">skipped</div></div>
    {% else %}
      <div class="f"><div class="idx">3</div><div class="name">Rule Engine</div><div class="out">{{ stats.applicable_entities }} 实体参与</div></div>
      <div class="f"><div class="idx">4</div><div class="name">Annotate + Report</div><div class="out">annotated.pdf · report.md</div></div>
      <div class="f"><div class="idx">5</div><div class="name">Feedback</div><div class="out">report.md → feedback.yaml</div></div>
    {% endif %}
  </div>

  <div class="risk">
    <div class="risk-item">
      <b style="color: var(--red);">{{ issue_summary.error }}</b>
      <div class="t">高风险（违规）</div>
    </div>
    <div class="risk-item">
      <b style="color: var(--orange);">{{ issue_summary.warning }}</b>
      <div class="t">提示（需核验）</div>
    </div>
    <div class="risk-item">
      <b style="color: var(--blue);">{{ issue_summary.info }}</b>
      <div class="t">人工核对清单</div>
    </div>
  </div>
</section>

<section class="panel full" id="panel-readiness">
  <h2>规则输入就绪度</h2>
  {% if not rule_readiness.available %}
    <div class="alert warn">
      <strong>规则输入就绪度暂无数据</strong>：缺失 readiness 不代表通过。旧 run 或仅识图模式可能没有
      <code>rule_input_readiness.json</code>。{{ rule_readiness.unavailable_reason }}
    </div>
  {% else %}
    <div class="alert warn">
      <strong>缺输入不等于通过</strong>：{{ rule_readiness.warning_text }}
    </div>
    <div class="kpis" style="margin-top: 12px;">
      {% for row in rule_readiness.summary_rows %}
        <div class="kpi {{ row.tone }}">
          <div class="k">{{ row.label }} · {{ row.status }}</div>
          <div class="v">{{ row.count }}</div>
        </div>
      {% endfor %}
    </div>
    <div class="metric-grid">
      <div class="metric-card">
        <h3>缺失/低置信输入来源</h3>
        {% if rule_readiness.source_rows %}
          <div class="bar">
            {% for row in rule_readiness.source_rows %}
              <div class="bar-row">
                <div class="bar-label">{{ row.source_label }}</div>
                <div class="bar-track">
                  <div class="bar-fill" style="width: {{ "%.1f"|format(100.0 * row.count / (rule_readiness.blocked_count or 1)) }}%; background: var(--orange);"></div>
                </div>
                <div class="bar-value">{{ row.count }}</div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="metric-note">当前没有 missing_input / low_confidence / unsupported_entity 来源。</div>
        {% endif %}
      </div>
      <div class="metric-card">
        <h3>非 ready 规则摘要</h3>
        <div class="table-wrap" style="max-height: 320px;">
          <table>
            <thead>
              <tr>
                <th>rule</th>
                <th>状态</th>
                <th>来源</th>
                <th>缺失输入</th>
                <th>说明</th>
              </tr>
            </thead>
            <tbody>
              {% for row in rule_readiness.non_ready_rules %}
                <tr>
                  <td><code>{{ row.rule_id }}</code></td>
                  <td><span class="status-pill {{ row.status_class }}">{{ row.status_label }}</span></td>
                  <td>{{ row.source_label }}</td>
                  <td><code>{{ row.missing_inputs }}</code></td>
                  <td>{{ row.reason }}</td>
                </tr>
              {% else %}
                <tr><td colspan="5">全部规则 ready。</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% if rule_readiness.omitted_non_ready_count %}
          <div class="metric-note">另有 {{ rule_readiness.omitted_non_ready_count }} 张非 ready 规则未展开，完整数据见 <code>rule_input_readiness.json</code>。</div>
        {% endif %}
      </div>
    </div>
    <div class="links">
      <a href="rule_input_readiness.json" target="_blank">rule_input_readiness.json</a>
    </div>
  {% endif %}
</section>

<section class="panel full" id="panel-sheet-regions">
  <h2>候选区域</h2>
  {% if not sheet_region_candidates.available %}
    <div class="alert warn">
      <strong>候选区域暂无数据</strong>：{{ sheet_region_candidates.warning_text }}
      {{ sheet_region_candidates.unavailable_reason }}
    </div>
  {% else %}
    <div class="alert warn">
      <strong>不自动裁剪</strong>：{{ sheet_region_candidates.warning_text }}
      如需应用候选，请复制 design_region 的坐标重新运行 <code>--sheet-region x0,y0,x1,y1</code>。
    </div>
    <div class="metric-grid">
      <div class="metric-card">
        <h3>区域候选</h3>
        {% if sheet_region_candidates.overlay_available %}
          <div class="img-card" style="margin-bottom: 10px;">
            <div class="img-head">候选区域框线层</div>
            <div class="img-wrap"><img src="{{ sheet_region_candidates.overlay_name }}" alt="sheet region candidates overlay" /></div>
          </div>
        {% endif %}
        <div class="table-wrap" style="max-height: 320px;">
          <table>
            <thead>
              <tr>
                <th>page</th>
                <th>kind</th>
                <th>region</th>
                <th>confidence</th>
                <th>reason</th>
              </tr>
            </thead>
            <tbody>
              {% for row in sheet_region_candidates.candidates %}
                <tr>
                  <td>{{ row.page_index }}</td>
                  <td><span class="pill">{{ row.kind }}</span> {{ row.kind_label }}</td>
                  <td><code>{{ row.copy_region }}</code></td>
                  <td>{{ "%.0f"|format(row.confidence_pct) }}%</td>
                  <td>{{ row.reason }}</td>
                </tr>
              {% else %}
                <tr><td colspan="5">当前未生成区域候选。</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% if sheet_region_candidates.omitted_candidate_count %}
          <div class="metric-note">另有 {{ sheet_region_candidates.omitted_candidate_count }} 个候选未展开，完整数据见 <code>sheet_region_candidates.json</code>。</div>
        {% endif %}
      </div>
      <div class="metric-card">
        <h3>候选排除文本摘要</h3>
        <div class="table-wrap" style="max-height: 320px;">
          <table>
            <thead>
              <tr>
                <th>page</th>
                <th>text</th>
                <th>bbox</th>
                <th>reason</th>
              </tr>
            </thead>
            <tbody>
              {% for row in sheet_region_candidates.excluded_texts %}
                <tr>
                  <td>{{ row.page_index }}</td>
                  <td>{{ row.text }}</td>
                  <td><code>{{ row.region }}</code></td>
                  <td>{{ row.reason }}</td>
                </tr>
              {% else %}
                <tr><td colspan="4">当前没有候选排除文本。</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% if sheet_region_candidates.omitted_excluded_count %}
          <div class="metric-note">另有 {{ sheet_region_candidates.omitted_excluded_count }} 条文本未展开，完整数据见 <code>sheet_region_candidates.json</code>。</div>
        {% endif %}
      </div>
    </div>
    <div class="links">
      <a href="sheet_region_candidates.json" target="_blank">sheet_region_candidates.json</a>
    </div>
  {% endif %}
</section>

{% if drawing_understanding is defined %}
<section class="panel full" id="panel-understanding">
  <h2>⑥ 图纸理解摘要</h2>
  <div class="kpis">
    <div class="kpi ok">
      <div class="k">图纸类型</div>
      <div class="v" style="font-size: 20px;">{{ drawing_understanding.drawing_type }}</div>
    </div>
    <div class="kpi">
      <div class="k">空间</div>
      <div class="v">{{ drawing_understanding.component_counts.rooms }}</div>
    </div>
    <div class="kpi">
      <div class="k">门/洞口</div>
      <div class="v">{{ drawing_understanding.component_counts.doors }}</div>
    </div>
    <div class="kpi">
      <div class="k">垂直交通</div>
      <div class="v">{{ drawing_understanding.component_counts.stairs }}</div>
    </div>
    <div class="kpi">
      <div class="k">尺寸证据</div>
      <div class="v">{{ drawing_understanding.component_counts.dimensions + drawing_understanding.dimension_evidence.ocr_dimension_count }}</div>
    </div>
  </div>
  <div class="metric-note" style="margin-top: 10px;">
    {{ drawing_understanding.summary }} 这是图纸内容识别摘要，不是规范纠错结论。
  </div>
  {% if drawing_understanding.drawing_profile is defined %}
    <div class="metric-note" style="margin-top: 10px;">识别档案</div>
    <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px;">
      <span class="pill">{{ drawing_understanding.drawing_profile.understanding_level }}</span>
      {% for signal in drawing_understanding.drawing_profile.evidence_signals %}
        <span class="pill">{{ signal }}</span>
      {% endfor %}
    </div>
  {% endif %}
  <div class="metric-grid">
    <div>
      <div class="metric-note">部件清单</div>
      <div class="evidence-list" style="margin-top: 8px;">
        {% for space in drawing_understanding.components.spaces[:4] %}
          <div class="evidence-row">
            <div>
              <div class="text">{{ space.label_zh }}</div>
              <div class="sub">{{ space.id }} · {{ space.area_text }}</div>
            </div>
            <div>
              <div class="sub">类型</div>
              <div>空间</div>
            </div>
            <div>
              <span class="pill">{{ "需核对" if space.uncertain else "已识别" }}</span>
            </div>
            <div class="sub">bbox {{ space.bbox_text }}</div>
          </div>
        {% endfor %}
        {% for opening in drawing_understanding.components.openings[:4] %}
          <div class="evidence-row">
            <div>
              <div class="text">门/洞口</div>
              <div class="sub">{{ opening.id }} · {{ opening.width_text }}</div>
            </div>
            <div>
              <div class="sub">类型</div>
              <div>开口</div>
            </div>
            <div>
              <span class="pill">{{ opening.connects_text }}</span>
            </div>
            <div class="sub">bbox {{ opening.bbox_text }}</div>
          </div>
        {% endfor %}
        {% for vertical in drawing_understanding.components.vertical_circulation[:4] %}
          <div class="evidence-row">
            <div>
              <div class="text">楼梯/垂直交通</div>
              <div class="sub">{{ vertical.id }} · {{ vertical.metric_text }}</div>
            </div>
            <div>
              <div class="sub">类型</div>
              <div>垂直交通</div>
            </div>
            <div>
              <span class="pill">{{ vertical.confidence_band }}</span>
            </div>
            <div class="sub">bbox {{ vertical.bbox_text }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
    <div>
      <div class="metric-note">尺寸证据</div>
      <div class="evidence-list" style="margin-top: 8px;">
        {% for dim in drawing_understanding.dimension_evidence.graph_dimensions[:3] %}
          <div class="evidence-row">
            <div>
              <div class="text">{{ dim.text }}</div>
              <div class="sub">graph dimension</div>
            </div>
            <div>
              <div class="sub">值</div>
              <div>{{ dim.value_text }}</div>
            </div>
            <div><span class="pill">实体图谱</span></div>
            <div class="sub">bbox {{ dim.bbox_text }}</div>
          </div>
        {% endfor %}
        {% for dim in drawing_understanding.dimension_evidence.ocr_dimensions[:3] %}
          <div class="evidence-row">
            <div>
              <div class="text">{{ dim.text }}</div>
              <div class="sub">OCR dimension</div>
            </div>
            <div>
              <div class="sub">值</div>
              <div>{{ dim.value_text }}</div>
            </div>
            <div><span class="pill">{{ dim.binding_state }}</span></div>
            <div class="sub">{{ dim.target_id or "未绑定" }}</div>
          </div>
        {% endfor %}
      </div>
      {% if drawing_understanding.uncertainty_flags %}
        <div class="metric-note" style="margin-top: 10px;">不确定点</div>
        {% for flag in drawing_understanding.uncertainty_flags[:4] %}
          <div class="alert warn" style="margin-top: 8px;">{{ flag }}</div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{% if ocr_diagnostics is defined and ocr_diagnostics.text_count %}
<section class="panel full" id="panel-ocr">
  <h2>⑦ OCR 证据面</h2>
  <div class="kpis">
    <div class="kpi">
      <div class="k">OCR 文本</div>
      <div class="v">{{ ocr_diagnostics.text_count }}</div>
    </div>
    <div class="kpi ok">
      <div class="k">已绑定房间</div>
      <div class="v">{{ ocr_diagnostics.bound_room_count }}</div>
    </div>
    <div class="kpi warn">
      <div class="k">低置信度</div>
      <div class="v">{{ ocr_diagnostics.low_confidence_count }}</div>
    </div>
    <div class="kpi">
      <div class="k">已有 label 的 Room</div>
      <div class="v">{{ ocr_diagnostics.labeled_room_count }}</div>
    </div>
    <div class="kpi warn">
      <div class="k">QA 候选</div>
      <div class="v">{{ ocr_diagnostics.qa_candidate_count }}</div>
    </div>
  </div>
  <div class="metric-note" style="margin-top: 10px;">
    OCR beta 只提供识别证据，不代表自动合规结论。低置信度阈值：
    {{ "%.0f"|format(ocr_diagnostics.low_confidence_threshold * 100) }}%；
    高置信度 label 阈值：{{ "%.0f"|format(ocr_diagnostics.high_confidence_label_threshold * 100) }}%。
  </div>
  {% if ocr_diagnostics.qa_candidate_count %}
    <div class="metric-note" style="margin-top: 12px;">
      <strong>OCR label QA 候选</strong>：以下仅为人工复核提示，不会自动修改 Room.label，也不会改变规则结论。
    </div>
    <div class="evidence-list" style="margin-top: 10px;">
      {% for candidate in ocr_diagnostics.qa_candidates %}
        <div class="evidence-row low">
          <div>
            <div class="text">{{ candidate.reason }}</div>
            <div class="sub">{{ candidate.text }} → {{ candidate.normalized_label }}</div>
          </div>
          <div>
            <div class="sub">置信度</div>
            <div>{{ "%.0f"|format(candidate.confidence_pct) }}%</div>
          </div>
          <div>
            <span class="pill">{{ candidate.room_label or "未绑定" }}</span>
          </div>
          <div class="sub">{{ candidate.detail }}</div>
        </div>
      {% endfor %}
    </div>
    {% if ocr_diagnostics.qa_omitted_count %}
      <div class="metric-note" style="margin-top: 10px;">
        另有 {{ ocr_diagnostics.qa_omitted_count }} 条 OCR label QA 候选未在此面板展示；完整数据见 primitives.json 与 entity_graph.json。
      </div>
    {% endif %}
  {% endif %}
  {% if ocr_diagnostics.dimension_text_count %}
    <div class="metric-note" style="margin-top: 12px;">
      <strong>OCR 尺寸绑定证据</strong>：以下展示 OCR 数字文本与 Door/Corridor 的绑定关系；这是实体尺寸证据，不是单独的合规结论。
    </div>
    <div class="kpis" style="margin-top: 10px;">
      <div class="kpi">
        <div class="k">OCR 尺寸文本</div>
        <div class="v">{{ ocr_diagnostics.dimension_text_count }}</div>
      </div>
      <div class="kpi ok">
        <div class="k">已绑定实体</div>
        <div class="v">{{ ocr_diagnostics.bound_dimension_count }}</div>
      </div>
      <div class="kpi warn">
        <div class="k">未绑定尺寸</div>
        <div class="v">{{ ocr_diagnostics.unbound_dimension_count }}</div>
      </div>
    </div>
    <div class="evidence-list" style="margin-top: 10px;">
      {% for row in ocr_diagnostics.dimension_rows %}
        <div class="evidence-row {% if not row.target_id %}low{% endif %}">
          <div>
            <div class="text">{{ row.text }}</div>
            <div class="sub">bbox {{ row.bbox_text }}</div>
          </div>
          <div>
            <div class="sub">OCR 值</div>
            <div>{{ row.value_text }}</div>
          </div>
          <div>
            <span class="pill">{{ row.binding_state }}</span>
          </div>
          <div class="sub">
            {% if row.target_id %}
              {{ row.target_id }} · entity={{ row.target_value_text }}
            {% else %}
              未匹配到 1m 内的 Door/Corridor
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    {% if ocr_diagnostics.dimension_omitted_count %}
      <div class="metric-note" style="margin-top: 10px;">
        另有 {{ ocr_diagnostics.dimension_omitted_count }} 条 OCR 尺寸文本未在此面板展示；完整数据见 primitives.json 与 entity_graph.json。
      </div>
    {% endif %}
  {% endif %}
  <div class="evidence-list" style="margin-top: 12px;">
    {% for row in ocr_diagnostics.rows %}
      <div class="evidence-row {% if row.low_confidence %}low{% endif %}">
        <div>
          <div class="text">{{ row.text }}</div>
          <div class="sub">bbox {{ row.bbox_text }}</div>
        </div>
        <div>
          <div class="sub">置信度</div>
          <div>{{ "%.0f"|format(row.confidence_pct) }}%</div>
        </div>
        <div>
          <span class="pill">{{ row.binding_state }}</span>
        </div>
        <div class="sub">
          {% if row.room_id %}
            {{ row.room_id }} · {{ row.room_label or "未分类" }}
          {% else %}
            未绑定到任何 Room polygon
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  {% if ocr_diagnostics.omitted_count %}
    <div class="metric-note" style="margin-top: 10px;">
      另有 {{ ocr_diagnostics.omitted_count }} 条 OCR 文本未在此面板展示；完整数据见 primitives.json。
    </div>
  {% endif %}
</section>
{% endif %}

<section class="panel">
  <h2>⑧ 知识库快照</h2>
  {% if knowledge_overview.error %}
    <div class="alert warn">知识库字段读取失败：{{ knowledge_overview.error }}</div>
  {% else %}
    <div class="knowledge-kpi">
      <div class="item">
        <div class="l">标准条文</div>
        <div class="n">{{ knowledge_overview.total_clauses }}</div>
      </div>
      <div class="item">
        <div class="l">规则卡</div>
        <div class="n">{{ knowledge_overview.total_rules }}</div>
      </div>
      <div class="item">
        <div class="l">住宅相关</div>
        <div class="n">{{ knowledge_overview.residential_rules }}</div>
      </div>
    </div>
    <div class="knowledge-grid">
      <div class="knowledge-card">
        <h3>来源 Top</h3>
        <div class="knowledge-list">
          {% for name, count in knowledge_overview.by_source[:4] %}
            <div class="knowledge-item">{{ name }} · {{ count }}</div>
          {% else %}
            <div class="knowledge-item">暂无</div>
          {% endfor %}
        </div>
      </div>
      <div class="knowledge-card">
        <h3>类别 Top</h3>
        <div class="knowledge-list">
          {% for name, count in knowledge_overview.by_category[:4] %}
            <div class="knowledge-item">{{ name }} · {{ count }}</div>
          {% else %}
            <div class="knowledge-item">暂无</div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
</section>

<section class="panel full" id="panel-layer">
  <h2>② 成果对照图</h2>
  <div class="layer-switch" role="tablist" aria-label="图层切换">
    <button class="chip {% if not layer_available.source %}is-disabled{% endif %}" data-layer="source" {% if not layer_available.source %}disabled{% endif %}>source</button>
    <button class="chip {% if not layer_available.overlay %}is-disabled{% endif %}" data-layer="overlay" {% if not layer_available.overlay %}disabled{% endif %}>entity overlay</button>
    <button class="chip {% if not layer_available.annotated %}is-disabled{% endif %}" data-layer="annotated" {% if not layer_available.annotated %}disabled{% endif %}>annotated</button>
  </div>
  <div class="gallery">
    <div class="img-card">
      <div class="img-head">图层对照 <span class="muted" id="layerState">source</span></div>
      <div class="img-wrap layer-view">
        <img id="layerImage" src="source_preview.png" alt="review layer" />
      </div>
    </div>
    <div class="img-card">
      <div class="img-head">标准图层参考</div>
      <div class="img-wrap">
        <div class="bar">
          <div class="bar-row"><span class="bar-label">source</span><span class="bar-value"><a href="source_preview.png" target="_blank">source_preview.png</a></span></div>
          <div class="bar-row"><span class="bar-label">entity overlay</span><span class="bar-value"><a href="entity_overlay.png" target="_blank">entity_overlay.png</a></span></div>
          <div class="bar-row"><span class="bar-label">annotated</span><span class="bar-value"><a href="annotated_preview.png" target="_blank">annotated_preview.png</a></span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="panel full" id="panel-issues">
  <h2>③ Issues ({% if mode is defined and mode == "inspect_only" %}规则未跑{% else %}{{ issues|length }}{% endif %})</h2>
  {% if mode is defined and mode == "inspect_only" %}
    <p style="color: var(--orange);">本次只跑识图，不输出规则问题。Issues 条目为空不等于合规。</p>
  {% elif issues %}
    <div class="issue-list">
      {% for i in issues %}
      {% set issue_tier = issue_tiers.get(i.rule_card_id, "UNKNOWN") %}
      {% set issue_tier_class = issue_tier | lower | replace('_', '-') %}
        <article class="issue-item tier-{{ issue_tier_class }}">
        <div class="line">
          {% set issue_sev = i.severity or "info" %}
          {% set severity_key = (issue_sev | lower | replace(" ", "")) %}
          <span class="level severity-{{ severity_key }}">{{ issue_sev | upper }}</span>
          <span><code>{{ i.issue_id }}</code></span>
          <span class="pill">{{ i.rule_card_id }}</span>
          <span class="pill tier-pill tier-{{ issue_tier_class }}">{{ issue_tier }}</span>
          <span class="pill">{{ i.standard_clause_id }}</span>
          <span class="pill">{{ i.entity_ids | join(', ') }}</span>
          {% if i.evidence.measured_value is not none and i.evidence.threshold_value is not none %}
            <span class="pill">{{ "%.2f"|format(i.evidence.measured_value) }} / {{ "%.2f"|format(i.evidence.threshold_value) }} {{ i.evidence.unit or '' }}</span>
          {% endif %}
        </div>
        <p class="issue-message">{{ i.message }}</p>
      </article>
      {% endfor %}
    </div>
  {% else %}
    <p style="color: var(--green);">✓ 未发现违反规则的实体（当前规则集合）。</p>
  {% endif %}

  <div class="links">
    <a href="entity_graph.json" target="_blank">entity_graph.json</a>
    {% if not (mode is defined and mode == "inspect_only") %}<a href="issues.json" target="_blank">issues.json</a>{% endif %}
    <a href="primitives.json" target="_blank">primitives.json</a>
    <a href="report.md" target="_blank">report.md</a>
    {% if not (mode is defined and mode == "inspect_only") %}<a href="feedback.yaml" target="_blank">feedback.yaml</a>{% endif %}
  </div>
</section>

<section class="panel full" id="panel-report">
  <h2>④ 标注 PDF</h2>
  <div class="gallery">
    <div class="img-card">
      <div class="img-head">{% if mode is defined and mode == "inspect_only" %}源图副本（无标注）{% else %}规则标注版{% endif %}</div>
      <div class="img-wrap"><img src="annotated_preview.png" alt="annotated preview" /></div>
    </div>
    <div class="report">
      <div style="font-size: 12px; color: var(--muted); margin-bottom: 8px;">审查报告快览</div>
      <pre>{{ report_md }}</pre>
    </div>
  </div>
  <div class="links" style="margin-top: 14px;">
    <a href="annotated.pdf" target="_blank">下载 PDF 标注/副本</a>
  </div>
</section>

<section class="panel full">
  <h2>⑤ 条文触达地图</h2>
  <div class="metric-grid">
    {% if clause_refs is defined and clause_refs %}
    <div>
      <ul class="ref-list">
        {% for row in clause_refs %}
        <li class="ref-item">
          <span class="ref-id">{{ row.clause_id }}</span>
          <div style="margin-top: 4px; color: var(--muted);">{{ row.source }} · {{ row.category }} · {{ row.threshold_value }} {{ row.unit }}</div>
          <div style="color: #d8e3ff; margin-top: 4px;">{{ row.clause_text }}</div>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% else %}
      <div>
        <p style="color: var(--muted);">当前未抽取到可汇总条文。</p>
      </div>
    {% endif %}

    <div class="metric-card">
      <h3>高频触发条文（Top {{ issue_metrics.top_clauses | length }}）</h3>
      <div class="bar">
        {% if issue_metrics.top_clauses %}
          {% for row in issue_metrics.top_clauses %}
            {% set pct = 0 %}
            {% if issue_summary.total %}
              {% set pct = 100.0 * row.count / issue_summary.total %}
            {% endif %}
            <div class="bar-row">
              <div class="bar-label">{{ row.source }}</div>
              <div class="bar-track">
                <div class="bar-fill" style="width: {{ "%.1f"|format(pct) }}%; background: linear-gradient(90deg, #4fd67a, #93edaa);"></div>
              </div>
              <div class="bar-value">{{ row.count }}</div>
            </div>
          {% endfor %}
        {% else %}
          <div class="bar-row" style="grid-template-columns:1fr;">
            <div class="bar-label" style="color: var(--muted);">当前无条文命中统计</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<div class="footer">本地只读结果页 · 每次运行都会保留 source.pdf、预览图和 report.md 供复核</div>

</div>
<script>
(function () {
  const layerImage = document.getElementById("layerImage");
  const layerState = document.getElementById("layerState");
  const chips = Array.from(document.querySelectorAll('.layer-switch .chip'));
  if (!layerImage || !layerState || !chips.length) {
    return;
  }
  const layerSources = {
    source: "source_preview.png",
    overlay: "entity_overlay.png",
    annotated: "annotated_preview.png",
  };
  const layerLabels = {
    source: "source",
    overlay: "entity overlay",
    annotated: "annotated",
  };

  function applyLayer(next) {
    const src = layerSources[next];
    if (!src) {
      return;
    }
    layerImage.src = src;
    layerImage.alt = `review layer ${layerLabels[next] || next}`;
    layerState.textContent = layerLabels[next] || next;
    chips.forEach((chip) => {
      chip.classList.toggle("active", chip.dataset.layer === next);
      chip.setAttribute("aria-pressed", chip.dataset.layer === next ? "true" : "false");
    });
  }

  chips.forEach((chip) => {
    chip.type = "button";
    chip.setAttribute("aria-pressed", chip.classList.contains("active") ? "true" : "false");
    chip.addEventListener("click", () => {
      applyLayer(chip.dataset.layer);
    });
  });

  const active = chips.find((c) => c.classList.contains("active") && !c.disabled);
  applyLayer((active && active.dataset.layer) || (chips.find((c) => !c.disabled) || chips[0]).dataset.layer);
})();
</script>
</body>
</html>
